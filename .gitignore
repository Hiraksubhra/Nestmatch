# ============================================================
# NestMatch — .gitignore
# ============================================================

# Environment files — NEVER commit these
.env
.env.local
.env.production
.env.*.local
frontend/.env
frontend/.env.local
backend/.env
backend/.env.local
*.env

# Node / Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python / Backend
__pycache__/
backend/__pycache__/
backend/*/__pycache__/
backend/*/*/__pycache__/
backend/*/*/*/__pycache__/
*.py[cod]
*.pyo
*$py.class
backend/.pytest_cache/
backend/htmlcov/
backend/.coverage
backend/.venv/
backend/env/
backend/venv/
backend/*.db
backend/*.sqlite3
backend/*.sqlite
*.egg-info/
dist/
build/
backend/alembic/__pycache__/

# Logs
*.log
logs/

# Operating System & IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Markdown & Documentation (ignore all markdown files except README)
*.md
**/*.md
!README.md
!readme.md

*.docx
