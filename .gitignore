# ============================================================
# NestMatch — .gitignore
# ============================================================

# Environment files — NEVER commit these
.env
.env.local
.env.production
.env.*.local

# Node / Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/

# Python / Backend
__pycache__/
*.py[cod]
*.pyo
backend/.venv/
backend/venv/
backend/.pytest_cache/
backend/htmlcov/
backend/.coverage
*.egg-info/
dist/
build/

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Logs
*.log
logs/

# Alembic (keep versions folder, ignore auto-generated pycache)
backend/alembic/__pycache__/
