# ============================================================
# NestMatch Frontend — Environment Variables
# Copy to .env.local — never commit .env.local to Git
# All frontend vars MUST start with VITE_
# ============================================================

# Backend API URL
VITE_API_URL=http://localhost:8000

# Google OAuth Client ID (same as backend, safe to expose in frontend)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
