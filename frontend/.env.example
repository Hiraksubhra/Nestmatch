# ============================================================
# NestMatch Frontend — Environment Variables
# Copy to .env or .env.local — never commit secrets to Git
# All frontend variables MUST start with VITE_
# ============================================================

# Backend API URLs
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_API_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000

# Google OAuth Client ID (same as backend, safe to expose in frontend)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Cloudinary
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
